[Unit]
Description=MaiaLinux LXQt Desktop Environment for Anbernic RG353V
After=network.target ssh.service systemd-user-sessions.service
Conflicts=emulationstation.service getty@tty1.service

[Service]
Type=simple
User=ark
Group=ark
WorkingDirectory=/home/ark
Environment=HOME=/home/ark
Environment=USER=ark
ExecStart=/usr/local/bin/start-maialinux.sh --service
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
