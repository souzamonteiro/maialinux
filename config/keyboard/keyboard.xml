<?xml version="1.0" encoding="UTF-8"?>
<keyboard>
<options>
</options>

<layout id="MaiaLinux Programming Keyboard">
    <row>
        <key><default display="1" /><shifted display="!" /><mod1 display="`" /></key>
        <key><default display="2" /><shifted display="@" /><mod1 display="~" /></key>
        <key><default display="3" /><shifted display="#" /><mod1 display="#" /></key>
        <key><default display="4" /><shifted display="$" /><mod1 display="$" /></key>
        <key><default display="5" /><shifted display="%" /><mod1 display="%" /></key>
        <key><default display="6" /><shifted display="^" /><mod1 display="^" /></key>
        <key><default display="7" /><shifted display="&amp;" /><mod1 display="&amp;" /></key>
        <key><default display="8" /><shifted display="*" /><mod1 display="*" /></key>
        <key><default display="9" /><shifted display="(" /><mod1 display="(" /></key>
        <key><default display="0" /><shifted display=")" /><mod1 display=")" /></key>
        <key><default display="-" /><shifted display="_" /><mod1 display="_" /></key>
        <key><default display="=" /><shifted display="+" /><mod1 display="+" /></key>
        <key width="1400"><default display="⇦" action="backspace" /></key>
    </row>

    <row>
        <key width="1200"><default display="Tab" action="tab" /></key>
        <key obey-caps="true"><default display="q" /><shifted display="Q" /><mod1 display="[" /></key>
        <key obey-caps="true"><default display="w" /><shifted display="W" /><mod1 display="]" /></key>
        <key obey-caps="true"><default display="e" /><shifted display="E" /><mod1 display="{" /></key>
        <key obey-caps="true"><default display="r" /><shifted display="R" /><mod1 display="}" /></key>
        <key obey-caps="true"><default display="t" /><shifted display="T" /><mod1 display="&lt;" action="xkeysym:less" /></key>
        <key obey-caps="true"><default display="y" /><shifted display="Y" /><mod1 display="&gt;" action="xkeysym:greater" /></key>
        <key obey-caps="true"><default display="u" /><shifted display="U" /><mod1 display="|" /></key>
        <key obey-caps="true"><default display="i" /><shifted display="I" /><mod1 display="\" /></key>
        <key obey-caps="true"><default display="o" /><shifted display="O" /><mod1 display="/" /></key>
        <key obey-caps="true"><default display="p" /><shifted display="P" /><mod1 display="`" /></key>
        <key width="1400"><default display="⏎" action="return" /></key>
    </row>

    <row>
        <key width="1200"><default display="Esc" action="escape" /></key>
        <key obey-caps="true"><default display="a" /><shifted display="A" /><mod1 display=";" /></key>
        <key obey-caps="true"><default display="s" /><shifted display="S" /><mod1 display=":" /></key>
        <key obey-caps="true"><default display="d" /><shifted display="D" /><mod1 display="&quot;" /></key>
        <key obey-caps="true"><default display="f" /><shifted display="F" /><mod1 display="'" /></key>
        <key obey-caps="true"><default display="g" /><shifted display="G" /><mod1 display="+" /></key>
        <key obey-caps="true"><default display="h" /><shifted display="H" /><mod1 display="-" /></key>
        <key obey-caps="true"><default display="j" /><shifted display="J" /><mod1 display="*" /></key>
        <key obey-caps="true"><default display="k" /><shifted display="K" /><mod1 display="/" /></key>
        <key obey-caps="true"><default display="l" /><shifted display="L" /><mod1 display="=" /></key>
        <key><default display=";" /><shifted display=":" /><mod1 display=":" /></key>
        <key><default display="'" /><shifted display="&quot;" /><mod1 display="&quot;" /></key>
    </row>

    <row>
        <key width="1300">
            <default display="⇧" action="modifier:shift" />
            <caps display="⬆" action="modifier:shift" />
        </key>
        <key obey-caps="true"><default display="z" /><shifted display="Z" /><mod1 display="\" /></key>
        <key obey-caps="true"><default display="x" /><shifted display="X" /><mod1 display="|" /></key>
        <key obey-caps="true"><default display="c" /><shifted display="C" /><mod1 display="&lt;" action="xkeysym:less" /></key>
        <key obey-caps="true"><default display="v" /><shifted display="V" /><mod1 display="&gt;" action="xkeysym:greater" /></key>
        <key obey-caps="true"><default display="b" /><shifted display="B" /><mod1 display="?" /></key>
        <key obey-caps="true"><default display="n" /><shifted display="N" /><mod1 display="!" /></key>
        <key obey-caps="true"><default display="m" /><shifted display="M" /><mod1 display="_" /></key>
        <key><default display="," /><shifted display="&lt;" action="xkeysym:less" /><mod1 display="," /></key>
        <key><default display="." /><shifted display="&gt;" action="xkeysym:greater" /><mod1 display="." /></key>
        <key><default display="/" /><shifted display="?" /><mod1 display="/" /></key>
        <key width="1200">
            <default display="?123" action="modifier:mod1" />
            <mod1 display="ABC" action="modifier:mod1" />
        </key>
        <key width="2200"><default display=" " action="space" /></key>
    </row>
</layout>
</keyboard>

